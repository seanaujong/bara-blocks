{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writing-blocks/essay/schema/routing.schema.json",
  "title": "Routing",
  "description": "A decision tree that maps 'what does this essay need to do?' to an essay type — the question to answer before picking components at all. A tool asks the question at `start`, walks a branch, and either lands on another question or a terminal essay type.",
  "type": "object",
  "required": ["start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "start": { "type": "string", "description": "id of the node to ask first." },
    "nodes": {
      "type": "object",
      "description": "Keyed by node id.",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "question", "branches"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "branches": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["answer", "leads_to"],
              "additionalProperties": false,
              "properties": {
                "answer": { "type": "string", "description": "The option a person picks, phrased as a description of what they need, not a jargon label." },
                "leads_to": {
                  "type": "object",
                  "required": ["kind", "id"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "type": "string", "enum": ["question", "type"] },
                    "id": { "type": "string", "description": "id of another node (kind: question) or an essay type (kind: type)." }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
